  <activity class="@textGrid.WordSearch" name="sopa de letras" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <color background="0xFFFFFF" />
     </style>
     <p>ENCUENTRA LAS SIGUIENTES PALABRAS:</p>
     <p>HUEVO,IMAGEN,INSTRUCTIVO,TITULO,MACETA,TENEDOR,MATERIALES,BARCO,SANDWICH,LETRAS</p>
    </cell>
    <cell border="false" type="final">
     <style>
      <color background="0xFFFFFF" />
     </style>
     <p>¡FELICIDADES!</p>
    </cell>
    <cell type="finalError">
     <style>
      <color background="0xFFFFFF" />
     </style>
     <p>INTENTA DE NUEVO...</p>
    </cell>
   </messages>
