    <container bgColor="0xFFCCCC">
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xCCFFFF" border="true" />
   </settings>
   <textGrid rows="15" columns="15" cellWidth="21.0" cellHeight="22.0" border="true">
    <style>
     <color background="0xFFFFFF" />
    </style>
    <text>
     <row>***********S**I</row>
     <row>******HUEVOA**N</row>
     <row>**M***BARCON**S</row>
     <row>**CA*******D**T</row>
     <row>T*U*C****I*W**R</row>
     <row>I*C**E***M*I**U</row>
     <row>TTH***T**A*C**C</row>
     <row>UEA****A*G*H**T</row>
     <row>LNR******E**R*I</row>
     <row>O*A******N**O*V</row>
     <row>*****LETRAS*D*O</row>
     <row>**E*********E**</row>
     <row>MATERIALES**N**</row>
     <row>**A*********E**</row>
     <row>************T**</row>
    </text>
   </textGrid>
   <clues>
    <clue id="0">SANDWICH</clue>
    <clue id="1">CUCHARA</clue>
    <clue id="2">INSTRUCTIVO</clue>
    <clue id="3">IMAGEN</clue>
